// ============================================================================
//  Esquema de base de datos — Sistema de Actividad de Publicadores "Ocoa"
//  ORM: Prisma · Motor: SQLite (desarrollo) — migrable a PostgreSQL (producción)
//
//  Nota: SQLite no soporta `enum` en Prisma, por lo que los campos de tipo
//  enumerado (rol, estado, sexo) se guardan como String y se validan en la
//  capa de aplicación mediante Zod y las constantes de `src/lib/constants.ts`.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
//  CONGREGACIONES  (inquilinos de la plataforma)
//  Cada congregación es independiente: sus grupos, publicadores, informes,
//  reuniones y usuarios no se mezclan con los de otra. El Superadmin es el
//  único usuario sin congregación asignada.
// ----------------------------------------------------------------------------
model Congregation {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique // identificador corto para enlaces (p. ej. "ocoa")
  active Boolean @default(true)

  // Días de reunión de ESTA congregación, como los devuelve Date.getDay():
  // 0 = domingo … 6 = sábado. Cada congregación tiene los suyos.
  //   midweekDay: la reunión de entre semana (lunes a viernes)
  //   weekendDay: la reunión de fin de semana (sábado o domingo)
  // Los valores por defecto son los que tenía el sistema cuando estaban fijos
  // en el código (jueves y sábado).
  midweekDay Int @default(4)
  weekendDay Int @default(6)

  // "Repetir los de Sonido" en la categoría Video: los disponibles de Video
  // son exactamente los de Audio, sin tener que escribirlos otra vez.
  videoSameAsAudio Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  groups                  Group[]
  publishers              Publisher[]
  reports                 MonthlyReport[]
  meetings                Meeting[]
  auxiliaryPioneerSignups AuxiliaryPioneerSignup[]
  auxPioneerSettings      AuxPioneerSetting[]
  auditLogs               AuditLog[]
  assignmentHistory       AssignmentHistory[]
  respVolunteers          ResponsibilityVolunteer[]
}

// ----------------------------------------------------------------------------
//  USUARIOS  (Secretario, Superintendente, Auxiliar)
// ----------------------------------------------------------------------------
model User {
  id           String  @id @default(cuid())
  // El usuario es único en TODA la plataforma: así el inicio de sesión sigue
  // pidiendo solo usuario y contraseña, sin elegir congregación.
  username     String  @unique
  passwordHash String
  // Copia recuperable de la contraseña, solo para que el Secretario pueda
  // consultarla desde "Ver Credenciales" (protegida por pregunta de seguridad).
  // Se actualiza al crear el usuario y cada vez que se cambia la contraseña.
  plainPassword String?
  name         String
  role         String // SECRETARIO | SUPERINTENDENTE | AUXILIAR

  // Secretario => groupId nulo (acceso total).
  // Superintendente/Auxiliar => vinculado a UN grupo.
  // Modelar la asignación por groupId+role permite "designar temporalmente"
  // a otro usuario en el grupo sin perder el historial.
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  active             Boolean @default(true)
  mustChangePassword Boolean @default(false)

  // Congregación a la que pertenece. Nulo solo para el SUPERADMIN, que
  // administra la plataforma y no pertenece a ninguna.
  congregationId String?
  congregation   Congregation? @relation(fields: [congregationId], references: [id], onDelete: SetNull)

  // Rol adicional: además de su rol base, también es Encargado de Confirmaciones
  // (acceso a la sección Reuniones). Permite combinar p.ej. Superintendente +
  // Confirmaciones, o Auxiliar + Confirmaciones.
  alsoConfirmador Boolean @default(false)

  // Etiqueta secundaria en un grupo para el Administrador (SUPERINTENDENTE |
  // AUXILIAR). No cambia sus permisos (sigue con acceso total); es solo una
  // designación visible, junto con groupId.
  groupRoleLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones inversas
  statusChanges    StatusChange[]  @relation("StatusChangedBy")
  reportsSubmitted MonthlyReport[] @relation("ReportSubmittedBy")
  auditLogs        AuditLog[]
  meetingsCreated  Meeting[]       @relation("MeetingCreatedBy")

  @@index([groupId])
  @@index([role])
}

// ----------------------------------------------------------------------------
//  GRUPOS DE SERVICIO
// ----------------------------------------------------------------------------
model Group {
  id   String @id @default(cuid())
  name String

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  publishers Publisher[]

  // "Grupo 1" puede existir en varias congregaciones, pero no dos veces en la
  // misma (antes el nombre era único en toda la plataforma).
  @@unique([congregationId, name])
  @@index([congregationId])
}

// ----------------------------------------------------------------------------
//  PUBLICADORES
// ----------------------------------------------------------------------------
model Publisher {
  id          String    @id @default(cuid())
  fullName    String
  sex         String? // M | F  (opcional)
  birthDate   DateTime? // opcional
  baptismDate DateTime? // si aplica
  // Casillas de la tarjeta S-21 (opcionales):
  hope      String? // OTRAS_OVEJAS | UNGIDO
  privilege String? // ANCIANO | SIERVO_MINISTERIAL
  status      String // ver PUBLISHER_STATUSES en constants.ts
  active      Boolean   @default(true)

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusChanges StatusChange[]
  respVolunteers ResponsibilityVolunteer[]
  reports       MonthlyReport[]

  @@index([congregationId])
  @@index([groupId])
  @@index([status])
}

// ----------------------------------------------------------------------------
//  HISTORIAL DE CAMBIOS DE ESTADO DE UN PUBLICADOR
// ----------------------------------------------------------------------------
model StatusChange {
  id          String    @id @default(cuid())
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  status      String
  changedAt   DateTime  @default(now())

  changedById String?
  changedBy   User?   @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([publisherId])
}

// ----------------------------------------------------------------------------
//  INFORMES MENSUALES  (un registro por publicador / año / mes)
// ----------------------------------------------------------------------------
model MonthlyReport {
  id String @id @default(cuid())

  // Se guarda también aquí (además de en el publicador) porque los informes se
  // consultan directamente por año y mes en Estadísticas, Historial y Exportar.
  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  year  Int // ej. 2026
  month Int // 1..12

  participated Boolean @default(false) // participó en la predicación (Sí/No)
  bibleStudies Int     @default(0) // cantidad de cursos bíblicos
  hours        Int? // horas de predicación — precursores (regular o auxiliar del mes)

  // Precursor Auxiliar para ESTE mes (aunque no lo sea de forma permanente).
  // Cuando es true, el publicador reporta horas en este informe.
  auxiliaryPioneer Boolean @default(false)

  // Comentario opcional del informe (lo agrega quien carga el informe).
  comment String?

  // Estado del publicador en el momento del informe (para estadísticas históricas
  // fiables aunque el estado cambie después).
  statusAtReport String

  submittedById String?
  submittedBy   User?   @relation("ReportSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([publisherId, year, month])
  @@index([congregationId])
  @@index([year, month])
}

// ----------------------------------------------------------------------------
//  REUNIONES DE LA CONGREGACIÓN
// ----------------------------------------------------------------------------
model Meeting {
  id   String   @id @default(cuid())
  date DateTime
  day  String // JUEVES | SABADO

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  // Etiqueta de la semana (rango) mostrada en vez de una fecha única, p. ej.
  // "20-26 de Julio". Opcional; si es null se muestra la fecha.
  weekLabel String?

  // "Responsable de Confirmación" mostrado en la reunión (texto libre).
  confirmadorName String?

  // Datos del programa impreso que no son asignaciones de nadie: se leen de la
  // planilla al importar y se usan al generar el PDF del programa.
  //   weeklyReading: "Lectura semanal de la Biblia" (ej. "JEREMÍAS 40, 41")
  //   songStart / songMiddle / songEnd: número de cada canción
  // Nulos cuando la planilla no los traía: nunca se inventa un número.
  weeklyReading String?
  songStart     String?
  songMiddle    String?
  songEnd       String?

  createdById String?
  createdBy   User?   @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments MeetingAssignment[]

  // Una sola reunión por fecha y tipo de día: evita que dos personas que
  // guardan a la vez creen dos reuniones del mismo día (ya ocurrió).
  // La fecha siempre se guarda al mediodía local, así que la pareja
  // (date, day) identifica la reunión sin ambigüedad.
  @@unique([congregationId, date, day])
  @@index([date])
  @@index([congregationId])
}

// Una casilla de asignación/responsabilidad dentro de una reunión.
// Puede tener 1 o 2 hermanos (principal = Responsable, secundario = Auxiliar).
/**
 * Hermanos disponibles para cada tipo de responsabilidad.
 *
 * Es la lista con la que trabaja la asignación automática: quién puede hacer
 * de acomodador, pasar micrófono, audio, vídeo o plataforma. Un mismo hermano
 * puede estar en varias categorías.
 *
 * Apunta al publicador (no a un nombre escrito), así que si se elimina el
 * publicador desaparece también de estas listas.
 */
model ResponsibilityVolunteer {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  // Ver RESP_CATEGORIES en constants.ts
  category String

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Un hermano una sola vez por categoría.
  @@unique([congregationId, category, publisherId])
  @@index([congregationId])
  @@index([publisherId])
}

/**
 * Historial de asignaciones de reuniones ya eliminadas.
 *
 * Al borrar una reunión, sus asignaciones se copian aquí antes de desaparecer
 * (en la misma transacción), para que las Estadísticas de Asignaciones no
 * pierdan el historial. Los datos van desnormalizados a propósito: la reunión
 * ya no existe, así que la fecha y la etiqueta de la semana se guardan aquí.
 *
 * Son filas congeladas: no se editan ni se vuelven a marcar como realizadas.
 */
model AssignmentHistory {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  // Datos de la reunión eliminada.
  meetingDate  DateTime
  day          String // JUEVES (entre semana) | SABADO (fin de semana)
  weekLabel    String?
  // Id original, solo informativo: la reunión ya no existe.
  meetingId    String?

  // Datos de la asignación, tal como estaban al eliminarla.
  slotKey String
  section String
  label   String
  order   Int     @default(0)

  primaryName   String?
  primaryStatus String?
  primaryDone   Boolean?

  secondaryName   String?
  secondaryStatus String?
  secondaryDone   Boolean?

  // Cuándo se eliminó la reunión y quién la eliminó.
  deletedAt   DateTime @default(now())
  deletedById String?

  @@index([congregationId])
  @@index([meetingDate])
}

model MeetingAssignment {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  slotKey String // identifica la casilla (ver constants.ts)
  section String // sección de la reunión (TESOROS, SMM, VC, ...)
  label   String // etiqueta visible de la casilla
  order   Int     @default(0)
  note    String? // anotación opcional

  // Si admite 2 hermanos, y si ambos son iguales (par) — guardado por asignación
  // para poder crear/eliminar asignaciones manualmente.
  allowTwo  Boolean @default(false)
  equalPair Boolean @default(false)

  // Hermano principal (Responsable)
  primaryName   String?
  primaryToken  String? @unique
  primaryStatus String  @default("PENDIENTE") // PENDIENTE | CONFIRMADO | RECHAZADO

  // Hermano secundario (Auxiliar) — solo en casillas que permiten 2
  secondaryName   String?
  secondaryToken  String? @unique
  secondaryStatus String  @default("PENDIENTE")

  // ¿Se REALIZÓ la asignación? Es distinto de la confirmación previa:
  //   null  = sin registrar (nadie lo marcó; es el valor de todo el historial)
  //   true  = la realizó
  //   false = no la realizó
  // Las estadísticas solo cuentan `true`, para no dar por hecho que lo
  // programado se llevó a cabo.
  primaryDone   Boolean?
  secondaryDone Boolean?
  doneMarkedAt  DateTime?

  @@unique([meetingId, slotKey])
  @@index([meetingId])
}

// ----------------------------------------------------------------------------
//  REGISTRO DE AUDITORÍA
// ----------------------------------------------------------------------------
model AuditLog {
  id String @id @default(cuid())

  // Nulo cuando la acción la hace el Superadmin fuera de una congregación.
  congregationId String?
  congregation   Congregation? @relation(fields: [congregationId], references: [id], onDelete: SetNull)

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String // CREAR | EDITAR | ELIMINAR | INGRESAR_SESION | REINICIAR_DATOS ...
  entity   String // Grupo | Usuario | Publicador | Informe ...
  entityId String?
  details  String? // texto/JSON con el detalle del cambio

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
}

// ----------------------------------------------------------------------------
//  INSCRIPCIONES DE PRECURSOR AUXILIAR (por mes)
//  El hermano se inscribe desde un enlace público (sin sesión). El período
//  (año/mes) viaja en el enlace que arma el Administrador, para que la
//  inscripción quede en el mes elegido y no en el mes actual.
// ----------------------------------------------------------------------------
model AuxiliaryPioneerSignup {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  name    String // nombre tal cual lo escribió el hermano
  nameKey String // nombre normalizado (para evitar duplicados por mes)
  hours   Int // 15 | 30
  year    Int
  month   Int // 1..12

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Una sola inscripción por persona y período EN SU congregación (antes el
  // nombre bloqueaba al tocayo de cualquier otra).
  @@unique([congregationId, nameKey, year, month])
  @@index([year, month])
  @@index([congregationId])
}

// Configuración por período de las inscripciones de Precursor Auxiliar.
// allow15h=false -> ese mes solo admite inscripción de 30 horas.
model AuxPioneerSetting {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  year     Int
  month    Int
  allow15h Boolean @default(true)

  updatedAt DateTime @updatedAt

  // Antes el interruptor de 15 horas era global: cambiarlo en una congregación
  // lo cambiaba en todas.
  @@unique([congregationId, year, month])
}
