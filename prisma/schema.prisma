// ============================================================================
//  Esquema de base de datos — Sistema de Actividad de Publicadores "Ocoa"
//  ORM: Prisma · Motor: SQLite (desarrollo) — migrable a PostgreSQL (producción)
//
//  Nota: SQLite no soporta `enum` en Prisma, por lo que los campos de tipo
//  enumerado (rol, estado, sexo) se guardan como String y se validan en la
//  capa de aplicación mediante Zod y las constantes de `src/lib/constants.ts`.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
//  CONGREGACIONES  (inquilinos de la plataforma)
//  Cada congregación es independiente: sus grupos, publicadores, informes,
//  reuniones y usuarios no se mezclan con los de otra. El Superadmin es el
//  único usuario sin congregación asignada.
// ----------------------------------------------------------------------------
model Congregation {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique // identificador corto para enlaces (p. ej. "ocoa")
  active Boolean @default(true)

  // Días de reunión de ESTA congregación, como los devuelve Date.getDay():
  // 0 = domingo … 6 = sábado. Cada congregación tiene los suyos.
  //   midweekDay: la reunión de entre semana (lunes a viernes)
  //   weekendDay: la reunión de fin de semana (sábado o domingo)
  // Los valores por defecto son los que tenía el sistema cuando estaban fijos
  // en el código (jueves y sábado).
  midweekDay Int @default(4)
  weekendDay Int @default(6)

  // "Repetir los de Sonido" en la categoría Video: los disponibles de Video
  // son exactamente los de Audio, sin tener que escribirlos otra vez.
  videoSameAsAudio Boolean @default(false)

  // Cuántos hermanos pasan el micrófono en cada reunión: 1 o 2. Hay
  // congregaciones que solo usan uno, y entonces la casilla "Pasa Micrófono 2"
  // quedaba siempre vacía. Por defecto 2, que es lo que hacía el sistema
  // cuando el número estaba fijo en el código.
  micCount Int @default(2)

  // "El mismo hermano hace Audio y Video": quien está en Audio se encarga
  // también del Video, así que no se reparte ni se imprime una casilla de
  // Video aparte. Es distinto de videoSameAsAudio, que solo comparte la LISTA
  // de hermanos disponibles.
  audioAlsoVideo Boolean @default(false)

  // "Un solo hermano como acomodador de entrada y de auditorio": el que está
  // en Acomodador de Entrada cubre las dos puertas, así que no se reparte ni
  // se imprime una casilla de Auditorio aparte, y la que queda pasa a
  // llamarse "Acomodador de Auditorio y de Entrada".
  ushersMerged Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  groups                  Group[]
  publishers              Publisher[]
  reports                 MonthlyReport[]
  meetings                Meeting[]
  auxiliaryPioneerSignups AuxiliaryPioneerSignup[]
  auxPioneerSettings      AuxPioneerSetting[]
  auditLogs               AuditLog[]
  assignmentHistory       AssignmentHistory[]
  respVolunteers          ResponsibilityVolunteer[]
  territories             Territory[]
  territoryVisits         TerritoryVisit[]
  serviceOutings          ServiceOuting[]
  servicePresets          ServicePreset[]
  meetingAttendance       MeetingAttendance[]
  captainSlots            CaptainTimeSlot[]
  captainSurveys          CaptainSurvey[]
  captainResponses        CaptainResponse[]
}

// ----------------------------------------------------------------------------
//  USUARIOS  (Secretario, Superintendente, Auxiliar)
// ----------------------------------------------------------------------------
model User {
  id           String  @id @default(cuid())
  // El usuario es único en TODA la plataforma: así el inicio de sesión sigue
  // pidiendo solo usuario y contraseña, sin elegir congregación.
  username     String  @unique
  passwordHash String
  // Copia recuperable de la contraseña, solo para que el Secretario pueda
  // consultarla desde "Ver Credenciales" (protegida por pregunta de seguridad).
  // Se actualiza al crear el usuario y cada vez que se cambia la contraseña.
  plainPassword String?
  name         String
  role         String // SECRETARIO | SUPERINTENDENTE | AUXILIAR

  // Secretario => groupId nulo (acceso total).
  // Superintendente/Auxiliar => vinculado a UN grupo.
  // Modelar la asignación por groupId+role permite "designar temporalmente"
  // a otro usuario en el grupo sin perder el historial.
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  active             Boolean @default(true)
  mustChangePassword Boolean @default(false)

  // Congregación a la que pertenece. Nulo solo para el SUPERADMIN, que
  // administra la plataforma y no pertenece a ninguna.
  congregationId String?
  congregation   Congregation? @relation(fields: [congregationId], references: [id], onDelete: SetNull)

  // Rol adicional: además de su rol base, también es Encargado de Confirmaciones
  // (acceso a la sección Reuniones). Permite combinar p.ej. Superintendente +
  // Confirmaciones, o Auxiliar + Confirmaciones.
  alsoConfirmador Boolean @default(false)

  // Rol adicional: acceso a la sección Superintendente de Servicio
  // (territorios, mapas, programa de predicación y sus estadísticas). Todos
  // los que la tienen trabajan sobre los mismos datos de la congregación.
  alsoTerritorios Boolean @default(false)

  // Rol adicional: puede subir su propia disponibilidad como capitán de
  // predicación. No da acceso a nada más.
  alsoCapitan Boolean @default(false)

  // Etiqueta secundaria en un grupo para el Administrador (SUPERINTENDENTE |
  // AUXILIAR). No cambia sus permisos (sigue con acceso total); es solo una
  // designación visible, junto con groupId.
  groupRoleLabel String?

  // Última señal de vida de una pestaña abierta con la aplicación. La manda
  // el propio navegador cada poco mientras la tiene abierta, y se borra al
  // cerrar sesión. Sirve para saber quién está CONECTADO ahora, que no es lo
  // mismo que tener la sesión iniciada: una pestaña cerrada deja de avisar y
  // la persona desaparece sola de la lista.
  // Se escribe con SQL directo para no tocar updatedAt en cada latido.
  lastSeenAt DateTime?

  // La última vez que esta persona usó de verdad la plataforma. A diferencia
  // de lastSeenAt, esta NO se borra nunca: sirve para responder "¿cuándo entró
  // por última vez?" cuando aparece desconectada.
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones inversas
  statusChanges    StatusChange[]  @relation("StatusChangedBy")
  reportsSubmitted MonthlyReport[] @relation("ReportSubmittedBy")
  auditLogs        AuditLog[]
  meetingsCreated  Meeting[]       @relation("MeetingCreatedBy")
  captainResponses CaptainResponse[]

  @@index([groupId])
  @@index([role])
}

// ----------------------------------------------------------------------------
//  GRUPOS DE SERVICIO
// ----------------------------------------------------------------------------
model Group {
  id   String @id @default(cuid())
  name String

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  publishers Publisher[]

  // "Grupo 1" puede existir en varias congregaciones, pero no dos veces en la
  // misma (antes el nombre era único en toda la plataforma).
  @@unique([congregationId, name])
  @@index([congregationId])
}

// ----------------------------------------------------------------------------
//  PUBLICADORES
// ----------------------------------------------------------------------------
model Publisher {
  id          String    @id @default(cuid())
  fullName    String
  sex         String? // M | F  (opcional)
  birthDate   DateTime? // opcional
  baptismDate DateTime? // si aplica
  // Casillas de la tarjeta S-21 (opcionales):
  hope      String? // OTRAS_OVEJAS | UNGIDO
  privilege String? // ANCIANO | SIERVO_MINISTERIAL
  status      String // ver PUBLISHER_STATUSES en constants.ts
  active      Boolean   @default(true)

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusChanges StatusChange[]
  respVolunteers ResponsibilityVolunteer[]
  reports       MonthlyReport[]

  @@index([congregationId])
  @@index([groupId])
  @@index([status])
}

// ----------------------------------------------------------------------------
//  HISTORIAL DE CAMBIOS DE ESTADO DE UN PUBLICADOR
// ----------------------------------------------------------------------------
model StatusChange {
  id          String    @id @default(cuid())
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  status      String
  changedAt   DateTime  @default(now())

  changedById String?
  changedBy   User?   @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([publisherId])
}

// ----------------------------------------------------------------------------
//  INFORMES MENSUALES  (un registro por publicador / año / mes)
// ----------------------------------------------------------------------------
model MonthlyReport {
  id String @id @default(cuid())

  // Se guarda también aquí (además de en el publicador) porque los informes se
  // consultan directamente por año y mes en Estadísticas, Historial y Exportar.
  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  year  Int // ej. 2026
  month Int // 1..12

  participated Boolean @default(false) // participó en la predicación (Sí/No)
  bibleStudies Int     @default(0) // cantidad de cursos bíblicos
  hours        Int? // horas de predicación — precursores (regular o auxiliar del mes)

  // Precursor Auxiliar para ESTE mes (aunque no lo sea de forma permanente).
  // Cuando es true, el publicador reporta horas en este informe.
  auxiliaryPioneer Boolean @default(false)

  // Comentario opcional del informe (lo agrega quien carga el informe).
  comment String?

  // Estado del publicador en el momento del informe (para estadísticas históricas
  // fiables aunque el estado cambie después).
  statusAtReport String

  submittedById String?
  submittedBy   User?   @relation("ReportSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([publisherId, year, month])
  @@index([congregationId])
  @@index([year, month])
}

// ----------------------------------------------------------------------------
//  REUNIONES DE LA CONGREGACIÓN
// ----------------------------------------------------------------------------
model Meeting {
  id   String   @id @default(cuid())
  date DateTime
  day  String // JUEVES | SABADO

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  // Etiqueta de la semana (rango) mostrada en vez de una fecha única, p. ej.
  // "20-26 de Julio". Opcional; si es null se muestra la fecha.
  weekLabel String?

  // "Responsable de Confirmación" mostrado en la reunión (texto libre).
  confirmadorName String?

  // Datos del programa impreso que no son asignaciones de nadie: se leen de la
  // planilla al importar y se usan al generar el PDF del programa.
  //   weeklyReading: "Lectura semanal de la Biblia" (ej. "JEREMÍAS 40, 41")
  //   songStart / songMiddle / songEnd: número de cada canción
  // Nulos cuando la planilla no los traía: nunca se inventa un número.
  weeklyReading String?
  songStart     String?
  songMiddle    String?
  songEnd       String?

  // Datos propios de la reunión de FIN DE SEMANA, para su programa impreso.
  // Tampoco son asignación de nadie (el orador suele venir de otra
  // congregación, y el tema y el grupo de hospitalidad no son personas).
  //   speakerName:      "Raúl Aguilera - Cabildo"
  //   talkNumber:       "10"
  //   talkTitle:        "Seamos honrados en todo"
  //   hospitalityGroup: "Grupo Nro 04" o "Congregación"
  speakerName      String?
  talkNumber       String?
  talkTitle        String?
  hospitalityGroup String?

  createdById String?
  createdBy   User?   @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments MeetingAssignment[]

  // Una sola reunión por fecha y tipo de día: evita que dos personas que
  // guardan a la vez creen dos reuniones del mismo día (ya ocurrió).
  // La fecha siempre se guarda al mediodía local, así que la pareja
  // (date, day) identifica la reunión sin ambigüedad.
  @@unique([congregationId, date, day])
  @@index([date])
  @@index([congregationId])
}

// Una casilla de asignación/responsabilidad dentro de una reunión.
// Puede tener 1 o 2 hermanos (principal = Responsable, secundario = Auxiliar).
/**
 * Hermanos disponibles para cada tipo de responsabilidad.
 *
 * Es la lista con la que trabaja la asignación automática: quién puede hacer
 * de acomodador, pasar micrófono, audio, vídeo o plataforma. Un mismo hermano
 * puede estar en varias categorías.
 *
 * Apunta al publicador (no a un nombre escrito), así que si se elimina el
 * publicador desaparece también de estas listas.
 */
model ResponsibilityVolunteer {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  // Ver RESP_CATEGORIES en constants.ts
  category String

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Un hermano una sola vez por categoría.
  @@unique([congregationId, category, publisherId])
  @@index([congregationId])
  @@index([publisherId])
}

/**
 * Historial de asignaciones de reuniones ya eliminadas.
 *
 * Al borrar una reunión, sus asignaciones se copian aquí antes de desaparecer
 * (en la misma transacción), para que las Estadísticas de Asignaciones no
 * pierdan el historial. Los datos van desnormalizados a propósito: la reunión
 * ya no existe, así que la fecha y la etiqueta de la semana se guardan aquí.
 *
 * Son filas congeladas: no se editan ni se vuelven a marcar como realizadas.
 */
model AssignmentHistory {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  // Datos de la reunión eliminada.
  meetingDate  DateTime
  day          String // JUEVES (entre semana) | SABADO (fin de semana)
  weekLabel    String?
  // Id original, solo informativo: la reunión ya no existe.
  meetingId    String?

  // Datos de la asignación, tal como estaban al eliminarla.
  slotKey String
  section String
  label   String
  order   Int     @default(0)

  primaryName   String?
  primaryStatus String?
  primaryDone   Boolean?

  secondaryName   String?
  secondaryStatus String?
  secondaryDone   Boolean?

  // Cuándo se eliminó la reunión y quién la eliminó.
  deletedAt   DateTime @default(now())
  deletedById String?

  @@index([congregationId])
  @@index([meetingDate])
}

model MeetingAssignment {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  slotKey String // identifica la casilla (ver constants.ts)
  section String // sección de la reunión (TESOROS, SMM, VC, ...)
  label   String // etiqueta visible de la casilla
  order   Int     @default(0)
  note    String? // anotación opcional

  // Si admite 2 hermanos, y si ambos son iguales (par) — guardado por asignación
  // para poder crear/eliminar asignaciones manualmente.
  allowTwo  Boolean @default(false)
  equalPair Boolean @default(false)

  // Hermano principal (Responsable)
  primaryName   String?
  primaryToken  String? @unique
  primaryStatus String  @default("PENDIENTE") // PENDIENTE | CONFIRMADO | RECHAZADO

  // Hermano secundario (Auxiliar) — solo en casillas que permiten 2
  secondaryName   String?
  secondaryToken  String? @unique
  secondaryStatus String  @default("PENDIENTE")

  // ¿Se REALIZÓ la asignación? Es distinto de la confirmación previa:
  //   null  = sin registrar (nadie lo marcó; es el valor de todo el historial)
  //   true  = la realizó
  //   false = no la realizó
  // Las estadísticas solo cuentan `true`, para no dar por hecho que lo
  // programado se llevó a cabo.
  primaryDone   Boolean?
  secondaryDone Boolean?
  doneMarkedAt  DateTime?

  @@unique([meetingId, slotKey])
  @@index([meetingId])
}

// ----------------------------------------------------------------------------
//  REGISTRO DE AUDITORÍA
// ----------------------------------------------------------------------------
model AuditLog {
  id String @id @default(cuid())

  // Nulo cuando la acción la hace el Superadmin fuera de una congregación.
  congregationId String?
  congregation   Congregation? @relation(fields: [congregationId], references: [id], onDelete: SetNull)

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String // CREAR | EDITAR | ELIMINAR | INGRESAR_SESION | REINICIAR_DATOS ...
  entity   String // Grupo | Usuario | Publicador | Informe ...
  entityId String?
  details  String? // texto/JSON con el detalle del cambio

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
}

// ----------------------------------------------------------------------------
//  INSCRIPCIONES DE PRECURSOR AUXILIAR (por mes)
//  El hermano se inscribe desde un enlace público (sin sesión). El período
//  (año/mes) viaja en el enlace que arma el Administrador, para que la
//  inscripción quede en el mes elegido y no en el mes actual.
// ----------------------------------------------------------------------------
model AuxiliaryPioneerSignup {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  name    String // nombre tal cual lo escribió el hermano
  nameKey String // nombre normalizado (para evitar duplicados por mes)
  hours   Int // 15 | 30
  year    Int
  month   Int // 1..12

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Una sola inscripción por persona y período EN SU congregación (antes el
  // nombre bloqueaba al tocayo de cualquier otra).
  @@unique([congregationId, nameKey, year, month])
  @@index([year, month])
  @@index([congregationId])
}

// Configuración por período de las inscripciones de Precursor Auxiliar.
// allow15h=false -> ese mes solo admite inscripción de 30 horas.
model AuxPioneerSetting {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  year     Int
  month    Int
  allow15h Boolean @default(true)

  updatedAt DateTime @updatedAt

  // Antes el interruptor de 15 horas era global: cambiarlo en una congregación
  // lo cambiaba en todas.
  @@unique([congregationId, year, month])
}

// ----------------------------------------------------------------------------
//  TERRITORIOS  (Superintendente de Servicio)
//
//  Cada congregación lleva sus territorios: número, nombre, su mapa y el
//  registro de cuándo se predicó cada uno. El orden lo decide quien los
//  administra (campo `order`), para poder subirlos y bajarlos en la lista.
// ----------------------------------------------------------------------------
model Territory {
  id     String @id @default(cuid())
  number Int // número del territorio (1, 2, 3…)
  name   String // "Camino al Túnel"
  order  Int // posición en la lista; se puede reordenar

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  map     TerritoryMap?
  visits  TerritoryVisit[]
  outings ServiceOuting[]

  // Dos territorios no pueden llevar el mismo número en la misma congregación.
  @@unique([congregationId, number])
  @@index([congregationId, order])
}

// El mapa va en su propia tabla a propósito: así los bytes de la imagen NUNCA
// viajan al listar los territorios, solo cuando se pide el mapa.
model TerritoryMap {
  territoryId String    @id
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  congregationId String
  data           Bytes // la imagen del mapa (JPEG o PNG)
  mime           String
  bytes          Int // tamaño, para poder enseñar cuánto ocupa
  /// Página del PDF de mapas de la que salió, si vino de ahí.
  sourcePage     Int?

  updatedAt DateTime @updatedAt

  @@index([congregationId])
}

// Las fotos de la franja de arriba del programa de predicación.
//
// Las sube la congregación desde la pantalla del programa y se quedan
// puestas mes a mes hasta que las cambie. Igual que los mapas: los bytes
// viven en su propia tabla y solo viajan cuando se piden.
model ProgramPhoto {
  id String @id @default(cuid())

  congregationId String
  /// Posición en la franja, de izquierda a derecha.
  order          Int
  data           Bytes // la foto (JPEG o PNG), ya reducida por el navegador
  mime           String
  bytes          Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([congregationId, order])
}

// Una vez que se predicó un territorio, anotada a mano.
// Las salidas del programa (ServiceOuting) cuentan igual para las
// estadísticas: no se copian aquí, se suman al calcular.
model TerritoryVisit {
  id String @id @default(cuid())

  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  date DateTime // a mediodía local, como el resto de las fechas
  note String?

  createdAt DateTime @default(now())

  @@index([congregationId, date])
  @@index([territoryId, date])
}

// Una salida de predicación del programa mensual.
model ServiceOuting {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  date  DateTime // a mediodía local
  turno String // MANANA | TARDE
  time  String // "9:30"
  place String // lugar de encuentro ("Salón del Reino")

  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  captainName String // capitán de la salida

  // Qué grupos salen: nombres separados por "|" ("Grupo 1|Grupo 2"). Vacío =
  // predicación de toda la congregación, que es como estaba antes. Van por
  // nombre, como captainName y place: lo que importa es lo que se imprime, y
  // así un grupo borrado no se lleva por delante el programa del mes pasado.
  groups String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([congregationId, date])
  @@index([territoryId])
}

// Capitanes y lugares de encuentro guardados, para elegirlos rápido.
model ServicePreset {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  kind  String // CAPITAN | LUGAR
  value String

  createdAt DateTime @default(now())

  @@unique([congregationId, kind, value])
  @@index([congregationId, kind])
}

// ----------------------------------------------------------------------------
//  ASISTENCIA A LAS REUNIONES  (registro S-88)
// ----------------------------------------------------------------------------
// Una fila por reunión y fecha. No se apoya en la tabla Meeting a propósito:
// la asistencia se anota aunque esa reunión no tenga programa cargado, y el
// historial debe sobrevivir a cualquier cambio en los días de reunión de la
// congregación.
model MeetingAttendance {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  date DateTime // a mediodía local, el día de la reunión
  // El TIPO de reunión, con los mismos valores que el resto de la aplicación:
  //   JUEVES = entre semana · SABADO = fin de semana
  day  String

  // ¿Hubo reunión normal? Por defecto sí; se marca No cuando se suspendió.
  held  Boolean @default(true)
  // Asistencia contada. Nulo = todavía no se anotó (no cuenta en promedios).
  count Int?
  // Observaciones ("Reunión suspendida", "Visita del superintendente"…).
  note  String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([congregationId, date, day])
  @@index([congregationId, date])
}

// ----------------------------------------------------------------------------
//  CAPITANES DE PREDICACIÓN  (encuesta mensual de disponibilidad)
// ----------------------------------------------------------------------------
// El Administrador configura los horarios de su congregación, abre una
// encuesta para un mes y la reparte por WhatsApp. Los hermanos marcan en un
// calendario los días que pueden ser capitanes, con qué horarios y en qué
// modalidad. Se responde por el enlace público o entrando con el usuario de
// siempre: las dos cosas acaban en las mismas filas.

/** Un horario que la congregación usa para salir a predicar. */
model CaptainTimeSlot {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  /** Como se escribe en la encuesta: "9:00 a 11:00". */
  label String
  /** Para ordenar la lista a mano. */
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sin horarios repetidos dentro de una misma congregación.
  @@unique([congregationId, label])
  @@index([congregationId])
}

/** La encuesta de un mes. Una por congregación y mes. */
model CaptainSurvey {
  id String @id @default(cuid())

  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  year  Int
  month Int

  /** Lo que va en el enlace público. No se puede adivinar. */
  token String @unique
  /** Cerrada = ya no admite respuestas nuevas. */
  open  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses CaptainResponse[]

  @@unique([congregationId, year, month])
  @@index([congregationId])
}

/** Lo que contesta un hermano a la encuesta de un mes. */
model CaptainResponse {
  id String @id @default(cuid())

  surveyId String
  survey   CaptainSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  // La congregación se repite aquí a propósito: así ninguna consulta de
  // respuestas puede quedarse sin el filtro, ni por descuido.
  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  name String
  /** El nombre en limpio, para no guardar dos veces al mismo hermano. */
  nameKey String
  /** Si respondió desde su sesión, queda apuntado quién fue. */
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days CaptainResponseDay[]

  @@unique([surveyId, nameKey])
  @@index([congregationId])
  @@index([surveyId])
}

/** Un día que el hermano puede, con sus horarios y su modalidad. */
model CaptainResponseDay {
  id String @id @default(cuid())

  responseId String
  response   CaptainResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  /** El día, a mediodía local. */
  date DateTime
  /** Los horarios elegidos para ESE día, separados por "|". */
  slots String @default("")
  /** Modalidad de ese día. */
  houseToHouse Boolean @default(true)
  zoom         Boolean @default(false)

  @@unique([responseId, date])
  @@index([responseId])
}
